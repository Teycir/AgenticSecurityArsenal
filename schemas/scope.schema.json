{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentsec/scope.schema.json",
  "title": "AgentSec authorization scope",
  "type": "object",
  "required": ["engagement", "authorized_by", "valid_until", "targets"],
  "properties": {
    "engagement": {"type": "string", "minLength": 1},
    "authorized_by": {"type": "string", "minLength": 1},
    "valid_until": {"type": "string", "format": "date-time"},
    "targets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["origin"],
        "properties": {
          "origin": {"type": "string", "format": "uri", "pattern": "^https?://[^/*?#]+/?$"},
          "description": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "accounts": {"type": "array", "items": {"type": "string"}},
    "excluded": {"type": "array", "items": {"type": "string"}},
    "rate_limit_per_minute": {"type": "integer", "minimum": 1},
    "allowed_test_classes": {"type": "array", "items": {"enum": ["passive", "configuration", "benign-canary", "lab-only"]}},
    "stop_conditions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
